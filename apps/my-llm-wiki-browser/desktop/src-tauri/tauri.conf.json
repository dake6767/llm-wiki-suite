{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My LLM Wiki Browser",
  "version": "2.0.2",
  "identifier": "to.htmlgo.llm-wiki",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My LLM Wiki Browser",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false
      },
      {
        "label": "setup",
        "title": "My LLM Wiki · Skills 与工具链",
        "url": "setup.html",
        "width": 1040,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJERDVCNDVFNkJFMjJBOEUKUldTT0t1SnJYclRWTFdoTkpYY1J0M2VxekF6ejBsblJQWHROeWJzNDhuTXN3U0ZCTUFoSHFzMEYK",
      "endpoints": [
        "https://wiki.htmlgo.to/_update/latest.json",
        "https://github.com/dake6767/llm-wiki-suite/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/my-llm-wiki"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../frontend/dist/": "frontend/"
    }
  }
}
