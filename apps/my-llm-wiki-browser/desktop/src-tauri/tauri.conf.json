{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My LLM Wiki Browser",
  "version": "1.0.2",
  "identifier": "to.htmlgo.llm-wiki",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "My LLM Wiki Browser",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../frontend/dist/": "frontend/"
    }
  }
}
