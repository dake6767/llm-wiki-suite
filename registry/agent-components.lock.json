{
  "schema": 1,
  "protocol": 5,
  "release_tag": "v1.0.34",
  "runtime": {
    "python": "3.12.10",
    "uv": "0.10.0"
  },
  "release_sources": [
    "https://wiki.htmlgo.to/_update/dl/{tag}/{asset}",
    "https://github.com/dake6767/llm-wiki-suite/releases/download/{tag}/{asset}"
  ],
  "components": {
    "documents": {
      "label": "Documents",
      "description": "Local PDF, DOCX, PPTX, XLSX and EPUB conversion",
      "default": true,
      "packages": ["markitdown==0.1.6"],
      "tools": {
        "markitdown": {
          "argv": ["{runtime_python}", "{component}/markitdown_runner.py"],
          "postcheck": ["--help"]
        }
      }
    },
    "web": {
      "label": "Web and authenticated social capture",
      "description": "Private Node/OpenCLI runtime and staged Browser Bridge extension",
      "default": true,
      "node": "22.23.1",
      "opencli": {
        "package": "@jackwener/opencli@1.8.6",
        "version": "1.8.6",
        "integrity": "sha512-2+phJOV7JkSeQR4uOnapAkhSwQDjNzHYzlCXZJBYiYi7bUxQz95nGbGuXeTseprZWES0kysVGySH63B1HG51hw=="
      },
      "extension": {
        "version": "1.0.22",
        "url": "https://github.com/jackwener/OpenCLI/releases/download/v1.8.6/opencli-extension-v1.0.22.zip",
        "sha256": "9d2e3d053948beab5d97124aa79b1532d2122e33e461eca56cac113afd33207a"
      },
      "tools": {
        "opencli": {
          "argv": ["{component}/node", "{component}/opencli/node_modules/@jackwener/opencli/dist/src/main.js"],
          "postcheck": ["--version"]
        }
      }
    },
    "video": {
      "label": "Video base",
      "description": "Pinned yt-dlp and portable FFmpeg for captions and audio conversion",
      "default": true,
      "packages": ["yt-dlp==2026.7.4", "imageio-ffmpeg==0.6.0"],
      "tools": {
        "yt-dlp": {
          "argv": ["{runtime_python}", "{component}/yt_dlp_runner.py"],
          "postcheck": ["--version"]
        },
        "ffmpeg": {
          "argv": ["{component}/ffmpeg"],
          "postcheck": ["-version"]
        }
      }
    },
    "asr-zh": {
      "label": "Chinese ASR",
      "description": "Isolated SenseVoice/FunASR runtime; models remain first-use downloads",
      "default": true,
      "packages": [
        "funasr==1.3.16",
        "torch==2.11.0",
        "torchaudio==2.11.0",
        "librosa==0.11.0",
        "modelscope==1.38.1"
      ],
      "python_profile": "asr-zh",
      "postcheck": ["-c", "import funasr, librosa, torch"]
    },
    "asr-other": {
      "label": "Non-Chinese ASR",
      "description": "Isolated faster-whisper runtime; models remain first-use downloads",
      "default": false,
      "packages": ["faster-whisper==1.2.1"],
      "python_profile": "asr-other",
      "runtime_env": {
        "cn": {"HF_ENDPOINT": "https://hf-mirror.com"},
        "global": {}
      },
      "postcheck": ["-c", "import faster_whisper"]
    }
  }
}
