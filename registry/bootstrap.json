{
  "version": 5,
  "updated_at": "2026-07-21",
  "python": {
    "minimum": "3.10"
  },
  "home": "~/.my-llm-wiki",
  "repo_url": "https://github.com/dake6767/llm-wiki-suite.git",
  "repo_mirrors": [
    {
      "name": "gitee",
      "region": "cn",
      "url": "https://gitee.com/dake6767/llm-wiki-suite.git",
      "direction": "pull-from-canonical"
    }
  ],
  "bootstrap_script_url": "https://raw.githubusercontent.com/dake6767/llm-wiki-suite/main/bootstrap.sh",
  "bootstrap_script_mirrors": [
    {
      "name": "gitee",
      "region": "cn",
      "url": "https://gitee.com/dake6767/llm-wiki-suite/raw/main/bootstrap.sh"
    }
  ],
  "agent_installer": {
    "protocol": 5,
    "entrypoint": "scripts/agent_install.py",
    "release_tag": "v1.0.36",
    "component_lock": "registry/agent-components.lock.json",
    "component_manifest_asset": "My-LLM-Wiki-Agent-Components_{platform}_{arch}.json",
    "release_sources": [
      "https://wiki.htmlgo.to/_update/dl/{tag}/{asset}",
      "https://github.com/dake6767/llm-wiki-suite/releases/download/{tag}/{asset}"
    ]
  },
  "windows_setup": {
    "required": true,
    "architecture": "x86_64",
    "asset": "My-LLM-Wiki-Setup.exe",
    "release_page": "https://github.com/dake6767/llm-wiki-suite/releases/latest",
    "download_url": "https://github.com/dake6767/llm-wiki-suite/releases/latest/download/My-LLM-Wiki-Setup.exe",
    "project_mirror_template": "https://wiki.htmlgo.to/_update/dl/{tag}/{asset}",
    "legacy_bootstrap": "unsupported",
    "agent_entrypoint": "inspect-plan-apply",
    "gui": "optional-recovery"
  },
  "default_repo_home": "~/.my-llm-wiki/suite",
  "connector_dir": "~/.my-llm-wiki/connector",
  "wiki_registry_path": "~/.my-llm-wiki/wikis.json",
  "migrates_from": {
    "_note": "One-time MOVE into ~/.my-llm-wiki on first launch of the rebuilt app (desktop paths::migrate_legacy). No symlink, no fallback reads — a clean cutover, so any leftover reference to these fails loudly.",
    "connector_dir": "~/.llm-wiki-connector",
    "wiki_registry_path": "~/.config/llm-wiki/wikis.json"
  },
  "agent_hosts": {
    "codex": {"detect_dir": "~/.codex", "skills_dir": "~/.codex/skills"},
    "claude": {"detect_dir": "~/.claude", "skills_dir": "~/.claude/skills"},
    "hermes": {"detect_dir": "~/.hermes", "skills_dir": "~/.hermes/skills"},
    "agents": {"detect_dir": "~/.agents", "skills_dir": "~/.agents/skills"},
    "workbuddy": {"detect_dir": "~/.workbuddy", "skills_dir": "~/.workbuddy/skills"},
    "openclaw": {"detect_dir": "~/.openclaw", "skills_dir": "~/.openclaw/skills"}
  },
  "install": {
    "lock_file": "~/.my-llm-wiki/install.lock",
    "backup_dir_name": ".llm-wiki-backups"
  },
  "default_wiki_root": "~/wikis/my-llm-wiki",
  "capture_toolchain": {
    "_note": "Single machine-readable catalog for capture capability profiles and receipt-only tool probes. Skills declare profile ids in registry/skills.json; preflight.py evaluates only requested profiles and maps missing tools back to Protocol 5 managed components.",
    "catalog": "skills/my-llm-wiki/references/toolchain.json"
  },
  "mcp": {
    "_note": "Post-install MCP maintenance only; never part of bootstrap, Browser installation, or default doctor. Local access uses the suite stdio bridge; remote access uses streamable HTTP. Explicit --host selection is the consent boundary. Registration is non-interactive and argv-based; manual hosts receive exact JSON and action-required status.",
    "server_name": "my-llm-wiki",
    "endpoint": "http://127.0.0.1:{port}/mcp",
    "local_default_transport": "stdio",
    "remote_default_transport": "http",
    "stdio_bridge_script": "scripts/mcp-stdio-bridge.py",
    "port_resolution": {
      "pref_file": "~/.my-llm-wiki/connector/server-port",
      "env": "LLM_WIKI_PORT",
      "default": 8800
    },
    "token_file": "~/.my-llm-wiki/connector/token",
    "hosts": {
      "claude": {
        "cli": "claude",
        "config_path": "~/.claude.json",
        "registered_check": {"format": "json", "pointer": ["mcpServers", "my-llm-wiki"]},
        "register_argv": ["claude", "mcp", "add", "--scope", "user", "my-llm-wiki", "--", "{python}", "{bridge_script}"],
        "unregister_argv": ["claude", "mcp", "remove", "--scope", "user", "my-llm-wiki"],
        "remote_register_command": "claude mcp add --scope user --transport http my-llm-wiki {remote_endpoint} --header \"Authorization: Bearer {token}\""
      },
      "hermes": {
        "cli": "hermes",
        "config_path": "~/.hermes/config.yaml",
        "registered_check": {"format": "text", "marker": "my-llm-wiki"},
        "register_argv": ["hermes", "mcp", "add", "my-llm-wiki", "--command", "{python}", "--args", "{bridge_script}"],
        "register_note": "Local stdio is intentional: Hermes' httpx can route loopback through the macOS system proxy and ignore the bypass list. The suite bridge disables proxies and reads the current Browser port/token at runtime.",
        "unregister_argv": ["hermes", "mcp", "remove", "my-llm-wiki"],
        "remote_register_command": "hermes mcp add my-llm-wiki --url {remote_endpoint} --auth header"
      },
      "codex": {
        "cli": "codex",
        "config_path": "~/.codex/config.toml",
        "registered_check": {"format": "text", "marker": "mcp_servers.my-llm-wiki"},
        "register_argv": ["codex", "mcp", "add", "my-llm-wiki", "--", "{python}", "{bridge_script}"],
        "unregister_argv": ["codex", "mcp", "remove", "my-llm-wiki"],
        "remote_register_command": "codex mcp add my-llm-wiki --url {remote_endpoint} --bearer-token-env-var LLM_WIKI_WEB_TOKEN",
        "register_note": "For a remote relay, export its token as LLM_WIKI_WEB_TOKEN and use the remote HTTP recipe. Local access needs no token in host config because the bridge reads the Browser token file at runtime."
      },
      "agents": {
        "cli": null,
        "config_path": null,
        "register_argv": null,
        "register_note": "No MCP registration CLI known for this host — use the equivalent CLI fallback (wiki_ops.py browser-search / local-search / read-pages)."
      },
      "workbuddy": {
        "cli": null,
        "config_path": "~/.workbuddy/mcp.json",
        "registered_check": {"format": "json", "pointer": ["mcpServers", "my-llm-wiki"]},
        "register_argv": null,
        "manual_config": {"mcpServers": {"my-llm-wiki": {"command": "{python}", "args": ["{bridge_script}"]}}},
        "register_note": "WorkBuddy has no registration CLI, so the user applies the printed JSON to the expanded per-user config path shown by the installer. Local HTTP loopback is deliberately not offered because its client can route it through the system proxy. A remote relay may still use native HTTPS."
      },
      "openclaw": {
        "cli": null,
        "config_path": null,
        "register_argv": null,
        "register_note": "OpenCLAW is wired for skills only; no MCP registration path has been verified for it yet. Use the equivalent CLI fallback (wiki_ops.py browser-search / local-search / read-pages) until one is."
      }
    }
  },
  "browser": {
    "slug": "my-llm-wiki-browser",
    "collection_path": "apps/my-llm-wiki-browser",
    "release_strategy": "download-release-first",
    "operation_lock_file": "~/.my-llm-wiki/browser.lock",
    "install_receipt": {
      "path": "~/.my-llm-wiki/browser/install.json",
      "schema": 1,
      "windows_product_name": "My LLM Wiki Browser",
      "windows_uninstall_key": "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\My LLM Wiki Browser",
      "windows_main_executable": "llm-wiki-desktop.exe",
      "windows_installer_timeout_seconds": 900,
      "windows_postcheck_timeout_seconds": 30
    },
    "download_policy": {
      "directory": "~/.my-llm-wiki/browser/releases",
      "socket_timeout_seconds": 20,
      "total_timeout_seconds": 300,
      "max_bytes": 2147483648
    },
    "install_locations": {
      "darwin_app_dir": "~/Applications"
    },
    "release_sources": [
      {
        "name": "htmlgo",
        "format": "tauri-latest",
        "url": "https://wiki.htmlgo.to/_update/latest.json",
        "note": "Project-owned release manifest/CDN. Primary source for mainland-China installations and the desktop auto-updater."
      },
      {
        "name": "github",
        "format": "github-release",
        "note": "Canonical GitHub Releases fallback."
      }
    ],
    "asset_patterns": {
      "darwin-arm64": [
        "My.LLM.Wiki.Browser*_aarch64.app.tar.gz",
        "My LLM Wiki Browser*_aarch64.app.tar.gz",
        "My-LLM-Wiki-Browser*_aarch64.app.tar.gz",
        "My.LLM.Wiki.Browser*_aarch64.dmg",
        "My LLM Wiki Browser*_aarch64.dmg",
        "My-LLM-Wiki-Browser*_aarch64.dmg",
        "*macos*aarch64*.dmg"
      ],
      "darwin-x64": [
        "My.LLM.Wiki.Browser*_x64.app.tar.gz",
        "My LLM Wiki Browser*_x64.app.tar.gz",
        "My-LLM-Wiki-Browser*_x64.app.tar.gz",
        "My.LLM.Wiki.Browser*_x64.dmg",
        "My LLM Wiki Browser*_x64.dmg",
        "My-LLM-Wiki-Browser*_x64.dmg",
        "*macos*x64*.dmg"
      ],
      "darwin-universal": [
        "My.LLM.Wiki.Browser*_universal.dmg",
        "My LLM Wiki Browser*_universal.dmg",
        "My-LLM-Wiki-Browser*_universal.dmg",
        "*macos*universal*.dmg"
      ],
      "windows-x64": [
        "My-LLM-Wiki-Browser*_x64-portable.zip",
        "My LLM Wiki Browser*_x64-portable.zip",
        "My.LLM.Wiki.Browser*_x64-setup.exe",
        "My LLM Wiki Browser*_x64-setup.exe",
        "My-LLM-Wiki-Browser*_x64-setup.exe",
        "My.LLM.Wiki.Browser*_x64.msi",
        "My LLM Wiki Browser*_x64.msi",
        "My-LLM-Wiki-Browser*_x64.msi"
      ],
      "linux-x64": [
        "My.LLM.Wiki.Browser*_amd64.AppImage",
        "My LLM Wiki Browser*_amd64.AppImage",
        "My-LLM-Wiki-Browser*_amd64.AppImage",
        "My.LLM.Wiki.Browser*_amd64.deb",
        "My LLM Wiki Browser*_amd64.deb",
        "My-LLM-Wiki-Browser*_amd64.deb"
      ]
    },
    "source_build": {
      "steps": [
        {"argv": ["npm", "ci", "--no-audit", "--no-fund"], "cwd": "apps/my-llm-wiki-browser/frontend", "timeout_seconds": 600},
        {"argv": ["npm", "run", "build"], "cwd": "apps/my-llm-wiki-browser/frontend", "timeout_seconds": 600},
        {"argv": ["cargo", "tauri", "build"], "cwd": "apps/my-llm-wiki-browser/desktop/src-tauri", "timeout_seconds": 1800}
      ]
    }
  },
  "first_run": {
    "host": "127.0.0.1",
    "port_pref_file": "~/.my-llm-wiki/connector/server-port",
    "port_env": "LLM_WIKI_PORT",
    "default_port": 8800,
    "health_path": "/api/v1/healthz",
    "token_file": "~/.my-llm-wiki/connector/token",
    "ready_timeout_seconds": 60,
    "_note": "Browser port is resolved like the app itself: port_pref_file > $LLM_WIKI_PORT > default_port. Health probe only needs liveness; 401/403 proves the server is up.",
    "_open_note": "First-run open waits up to ready_timeout_seconds for the launched app's loopback server, then opens http://host:port/?token=<token_file> in the system browser. The app writes token_file on first launch, so it is read after the server answers, never before."
  }
}
