{
  "schema": 1,
  "runtime": {
    "python": "3.12.10",
    "targets": {
      "darwin-arm64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20250529/cpython-3.12.10%2B20250529-aarch64-apple-darwin-install_only_stripped.tar.gz",
        "sha256": "2579c9ffcbb0a745f1de3d645612c7466269eb9a23316a54ece49d50c1c9122f"
      },
      "darwin-x64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20250529/cpython-3.12.10%2B20250529-x86_64-apple-darwin-install_only_stripped.tar.gz",
        "sha256": "f171af578ecdbbcf63cbb0abd08f382df3e0d091e98c3161b3f84cd9d0acc0fd"
      },
      "linux-x64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20250529/cpython-3.12.10%2B20250529-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz",
        "sha256": "f50d08e0304b15d752b22932047135c1dc02f81977b284e51288be9d90627bca"
      }
    }
  },
  "components": {
    "documents": {
      "label": "Documents",
      "description": "Local PDF, DOCX, PPTX, XLSX and EPUB conversion",
      "default": true,
      "packages": ["markitdown[pdf,docx,pptx,xlsx]==0.1.6"],
      "tools": {
        "markitdown": {
          "argv": ["{runtime_python}", "{component}/markitdown_runner.py"],
          "postcheck": ["--help"]
        }
      }
    },
    "web": {
      "label": "Web and authenticated social capture",
      "description": "Private Node/OpenCLI runtime and staged Browser Bridge extension",
      "default": true,
      "node": {
        "version": "22.23.1",
        "targets": {
          "darwin-arm64": {
            "url": "https://nodejs.org/dist/v22.23.1/node-v22.23.1-darwin-arm64.tar.gz",
            "sha256": "ef28d8fab2c0e4314522d4bb1b7173270aa3937e93b92cb7de79c112ac1fa953"
          },
          "darwin-x64": {
            "url": "https://nodejs.org/dist/v22.23.1/node-v22.23.1-darwin-x64.tar.gz",
            "sha256": "b8da981b8a0b1241b70249204916da76c63573ddf5814dbd2d1e41069105cb81"
          },
          "linux-x64": {
            "url": "https://nodejs.org/dist/v22.23.1/node-v22.23.1-linux-x64.tar.gz",
            "sha256": "7a8cb04b4a1df4eaf432125324b81b29a088e73570a23259a8de1c65d07fc129"
          }
        }
      },
      "opencli": {
        "package": "@jackwener/opencli@1.8.6",
        "version": "1.8.6",
        "integrity": "sha512-2+phJOV7JkSeQR4uOnapAkhSwQDjNzHYzlCXZJBYiYi7bUxQz95nGbGuXeTseprZWES0kysVGySH63B1HG51hw=="
      },
      "extension": {
        "version": "1.0.22",
        "url": "https://github.com/jackwener/OpenCLI/releases/download/v1.8.6/opencli-extension-v1.0.22.zip",
        "sha256": "9d2e3d053948beab5d97124aa79b1532d2122e33e461eca56cac113afd33207a"
      },
      "tools": {
        "opencli": {
          "argv": ["{component}/node", "{component}/opencli/node_modules/@jackwener/opencli/dist/src/main.js"],
          "postcheck": ["--version"]
        }
      }
    },
    "video": {
      "label": "Video base",
      "description": "Pinned yt-dlp, aria2c and portable FFmpeg for resilient captions and audio retrieval",
      "default": true,
      "packages": ["yt-dlp==2026.7.4", "imageio-ffmpeg==0.6.0"],
      "aria2": {
        "version": "1.37.0",
        "url": "https://github.com/aria2/aria2/releases/download/release-1.37.0/aria2-1.37.0.tar.xz",
        "sha256": "60a420ad7085eb616cb6e2bdf0a7206d68ff3d37fb5a956dc44242eb2f79b66b"
      },
      "tools": {
        "yt-dlp": {
          "argv": ["{runtime_python}", "{component}/yt_dlp_runner.py"],
          "postcheck": ["--version"]
        },
        "aria2c": {
          "argv": ["{component}/aria2c"],
          "postcheck": ["--version"]
        },
        "ffmpeg": {
          "argv": ["{component}/ffmpeg"],
          "postcheck": ["-version"]
        }
      }
    },
    "asr-zh": {
      "label": "Chinese ASR",
      "description": "Isolated SenseVoice/FunASR runtime; models remain first-use downloads",
      "default": true,
      "packages": [
        "funasr==1.3.16",
        "torch==2.11.0",
        "torchaudio==2.11.0",
        "soundfile==0.13.1",
        "modelscope==1.38.1"
      ],
      "linux": {
        "extra_index_url": "https://download.pytorch.org/whl/cpu",
        "packages": [
          "funasr==1.3.16",
          "torch==2.11.0+cpu",
          "torchaudio==2.11.0+cpu",
          "soundfile==0.13.1",
          "modelscope==1.38.1"
        ]
      },
      "python_profile": "asr-zh",
      "postcheck": ["-c", "import funasr, soundfile, torch"]
    },
    "asr-other": {
      "label": "Non-Chinese ASR",
      "description": "Isolated faster-whisper runtime; models remain first-use downloads",
      "default": false,
      "packages": ["faster-whisper==1.2.1"],
      "python_profile": "asr-other",
      "postcheck": ["-c", "import faster_whisper"]
    }
  }
}
