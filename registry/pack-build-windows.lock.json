{
  "schema": 1,
  "architecture": "x86_64",
  "python": {
    "version": "3.12.10",
    "url": "https://www.python.org/ftp/python/3.12.10/python-3.12.10-embeddable-amd64.zip",
    "sha256": "156c7eea90d58cd7e91a23f28a0056616b13e9f4cf4901b7b99b837b7848c6da"
  },
  "components": {
    "documents": {
      "label": "Documents",
      "description": "Local PDF, DOCX, PPTX, XLSX and EPUB conversion",
      "label_zh": "文档转换",
      "description_zh": "本地 PDF、DOCX、PPTX、XLSX、EPUB 转换",
      "default": true,
      "packages": ["markitdown[pdf,docx,pptx,xlsx]==0.1.6"],
      "tools": {
        "markitdown": {
          "argv": ["{runtime}/python.exe", "{component}/markitdown_runner.py"],
          "postcheck": ["--help"]
        }
      }
    },
    "web": {
      "label": "Web and authenticated social capture",
      "description": "Private Node/OpenCLI runtime plus the unpacked Browser Bridge extension",
      "label_zh": "网页与登录态社交抓取",
      "description_zh": "私有 Node/OpenCLI 运行时，含 Browser Bridge Chrome 扩展",
      "default": true,
      "node": {
        "version": "22.23.1",
        "url": "https://nodejs.org/dist/v22.23.1/node-v22.23.1-win-x64.zip",
        "sha256": "7df0bc9375723f4a86b3aa1b7cc73342423d9677a8df4538aca31a049e309c29"
      },
      "opencli": {
        "version": "1.8.6",
        "package": "@jackwener/opencli@1.8.6",
        "integrity": "sha512-2+phJOV7JkSeQR4uOnapAkhSwQDjNzHYzlCXZJBYiYi7bUxQz95nGbGuXeTseprZWES0kysVGySH63B1HG51hw=="
      },
      "extension": {
        "version": "1.0.22",
        "url": "https://github.com/jackwener/OpenCLI/releases/download/v1.8.6/opencli-extension-v1.0.22.zip",
        "sha256": "9d2e3d053948beab5d97124aa79b1532d2122e33e461eca56cac113afd33207a"
      },
      "tools": {
        "opencli": {
          "argv": ["{component}/node/node.exe", "{component}/opencli/node_modules/@jackwener/opencli/dist/src/main.js"],
          "postcheck": ["--version"]
        }
      }
    },
    "video": {
      "label": "Video base",
      "description": "Pinned yt-dlp, aria2c and portable FFmpeg for resilient captions and audio retrieval",
      "label_zh": "视频基础",
      "description_zh": "锁定版本的 yt-dlp、aria2c 与便携版 FFmpeg，用于可靠获取字幕与音频",
      "default": true,
      "yt_dlp": {
        "version": "2026.07.04",
        "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2026.07.04/yt-dlp.exe",
        "sha256": "52fe3c26dcf71fbdc85b528589020bb0b8e383155cfa81b64dd447bbe35e24b8"
      },
      "ffmpeg": {
        "version": "8.1.2",
        "url": "https://github.com/GyanD/codexffmpeg/releases/download/8.1.2/ffmpeg-8.1.2-essentials_build.zip",
        "sha256": "db580001caa24ac104c8cb856cd113a87b0a443f7bdf47d8c12b1d740584a2ec"
      },
      "aria2": {
        "version": "1.37.0",
        "url": "https://github.com/aria2/aria2/releases/download/release-1.37.0/aria2-1.37.0-win-64bit-build1.zip",
        "sha256": "67d015301eef0b612191212d564c5bb0a14b5b9c4796b76454276a4d28d9b288"
      },
      "tools": {
        "yt-dlp": {
          "argv": ["{runtime}/python.exe", "{component}/yt_dlp_runner.py"],
          "postcheck": ["--version"]
        },
        "aria2c": {
          "argv": ["{component}/aria2c.exe"],
          "postcheck": ["--version"]
        },
        "ffmpeg": {
          "argv": ["{component}/ffmpeg/bin/ffmpeg.exe"],
          "postcheck": ["-version"]
        }
      }
    },
    "asr-zh": {
      "label": "Chinese ASR",
      "description": "Isolated SenseVoice/FunASR runtime; models remain first-use downloads from ModelScope",
      "label_zh": "中文语音识别",
      "description_zh": "独立 SenseVoice/FunASR 运行时；模型首次使用时从 ModelScope 下载",
      "default": true,
      "packages": [
        "funasr==1.3.16",
        "torch==2.11.0",
        "torchaudio==2.11.0",
        "soundfile==0.13.1",
        "modelscope==1.38.1"
      ],
      "python_profile": "asr-zh",
      "postcheck": ["-c", "import funasr, soundfile, torch"]
    },
    "asr-other": {
      "label": "Non-Chinese ASR",
      "description": "Isolated faster-whisper runtime; models remain first-use downloads",
      "label_zh": "非中文语音识别",
      "description_zh": "独立 faster-whisper 运行时；模型首次使用时下载",
      "default": false,
      "packages": ["faster-whisper==1.2.1"],
      "python_profile": "asr-other",
      "postcheck": ["-c", "import faster_whisper"]
    }
  }
}
