{
  "version": 3,
  "profiles": {
    "capture.web": {"label": "Web capture", "tools": ["opencli", "agent-reach"]},
    "capture.doc": {"label": "Local document capture", "tools": ["markitdown"]},
    "capture.note": {"label": "First-party note capture", "tools": []},
    "capture.x.single": {"label": "Single X post capture", "tools": ["opencli", "agent-reach"]},
    "capture.x.bookmarks": {"label": "X bookmark sync", "tools": ["opencli"]},
    "capture.video": {
      "label": "Online video transcript capture",
      "tools": ["opencli", "yt-dlp", "ffmpeg", "sensevoice", "faster-whisper"]
    }
  },
  "tools": {
    "opencli": {
      "probe": {"kind": "command", "name": "opencli"},
      "windows_component": "web",
      "description": "logged-in browser capture with image localization",
      "home": "https://www.npmjs.com/package/@jackwener/opencli",
      "step_timeout_seconds": 600,
      "postcheck_timeout_seconds": 30,
      "postcheck": ["opencli", "--version"]
    },
    "agent-reach": {
      "probe": {"kind": "command", "name": "agent-reach"},
      "description": "multi-platform capture routing",
      "home": "https://github.com/Panniantong/agent-reach"
    },
    "yt-dlp": {
      "probe": {"kind": "command", "name": "yt-dlp"},
      "windows_component": "video",
      "description": "video metadata, captions, and audio-only download",
      "home": "https://github.com/yt-dlp/yt-dlp",
      "step_timeout_seconds": 600,
      "postcheck_timeout_seconds": 30,
      "postcheck": ["yt-dlp", "--version"]
    },
    "ffmpeg": {
      "probe": {"kind": "command", "name": "ffmpeg"},
      "windows_component": "video",
      "description": "audio conversion and cover handling",
      "home": "https://ffmpeg.org",
      "step_timeout_seconds": 900,
      "postcheck_timeout_seconds": 30,
      "postcheck": ["ffmpeg", "-version"]
    },
    "sensevoice": {
      "probe": {"kind": "python-module", "name": "funasr"},
      "windows_component": "asr-zh",
      "description": "SenseVoice/FunASR for Chinese video",
      "home": "https://github.com/FunAudioLLM/SenseVoice",
      "step_timeout_seconds": 1800,
      "postcheck_timeout_seconds": 30,
      "postcheck": ["funasr"]
    },
    "faster-whisper": {
      "probe": {"kind": "python-module", "name": "faster_whisper"},
      "windows_component": "asr-other",
      "runtime_ecosystems": ["huggingface"],
      "runtime_env": {
        "huggingface": {
          "cn": {"HF_ENDPOINT": "https://hf-mirror.com"},
          "global": {}
        }
      },
      "description": "local ASR for non-Chinese video",
      "home": "https://github.com/SYSTRAN/faster-whisper",
      "step_timeout_seconds": 1200,
      "postcheck_timeout_seconds": 30,
      "postcheck": ["faster_whisper"]
    },
    "markitdown": {
      "probe": {"kind": "command", "name": "markitdown"},
      "windows_component": "documents",
      "description": "local documents to Markdown",
      "home": "https://github.com/microsoft/markitdown",
      "step_timeout_seconds": 600,
      "postcheck_timeout_seconds": 30,
      "postcheck": ["markitdown", "--help"]
    }
  }
}
