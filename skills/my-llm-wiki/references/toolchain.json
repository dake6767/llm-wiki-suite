{
  "version": 4,
  "profiles": {
    "capture.web": {"label": "Web capture", "tools": ["opencli", "agent-reach"]},
    "capture.doc": {"label": "Local document capture", "tools": ["markitdown"]},
    "capture.note": {"label": "First-party note capture", "tools": []},
    "capture.x.single": {"label": "Single X post capture", "tools": ["opencli", "agent-reach"]},
    "capture.x.bookmarks": {"label": "X bookmark sync", "tools": ["opencli"]},
    "capture.video": {
      "label": "Online video transcript capture",
      "tools": ["opencli", "yt-dlp", "aria2c", "ffmpeg", "sensevoice", "faster-whisper"]
    }
  },
  "tools": {
    "opencli": {
      "kind": "command",
      "description": "logged-in browser capture with image localization",
      "home": "https://www.npmjs.com/package/@jackwener/opencli",
      "official_pack": "toolchain-base",
      "postcheck": ["--version"]
    },
    "agent-reach": {
      "kind": "command",
      "description": "agent-provided multi-platform capture routing",
      "home": "https://github.com/Panniantong/agent-reach",
      "postcheck": ["--help"]
    },
    "yt-dlp": {
      "kind": "command",
      "description": "video metadata, captions, and audio retrieval",
      "home": "https://github.com/yt-dlp/yt-dlp",
      "official_pack": "toolchain-base",
      "postcheck": ["--version"]
    },
    "aria2c": {
      "kind": "command",
      "description": "parallel and retryable media download fallback",
      "home": "https://github.com/aria2/aria2",
      "official_pack": "toolchain-base",
      "postcheck": ["--version"]
    },
    "ffmpeg": {
      "kind": "command",
      "description": "audio conversion and media handling",
      "home": "https://ffmpeg.org",
      "official_pack": "toolchain-base",
      "postcheck": ["-version"]
    },
    "sensevoice": {
      "kind": "python-profile",
      "profile": "asr-zh",
      "description": "SenseVoice/FunASR for Chinese audio",
      "home": "https://github.com/FunAudioLLM/SenseVoice",
      "official_pack": "asr-zh",
      "postcheck": ["-c", "import funasr"]
    },
    "faster-whisper": {
      "kind": "python-profile",
      "profile": "asr-other",
      "description": "faster-whisper for non-Chinese audio",
      "home": "https://github.com/SYSTRAN/faster-whisper",
      "official_pack": "asr-other",
      "postcheck": ["-c", "import faster_whisper"]
    },
    "markitdown": {
      "kind": "command",
      "description": "local documents to Markdown",
      "home": "https://github.com/microsoft/markitdown",
      "official_pack": "toolchain-base",
      "postcheck": ["--help"]
    }
  }
}
